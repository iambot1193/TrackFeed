// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  name             String?
  avatarUrl        String?
  emailVerified    DateTime?    // Data da verificação do e-mail
  verificationCode String?      // Código de 6 dígitos enviado
  resetToken       String?      @unique // Token para recuperação de senha
  resetTokenExpires DateTime?   // Expiração do token
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  preferences      Preference[]
  favorites        Favorite[]
  history          History[]
}

model Preference {
  id           String @id @default(uuid())
  userId       String
  categoryName String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryName])
  @@index([userId])
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  url         String
  source      String?
  imageUrl    String?
  publishedAt DateTime?
  savedAt     DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId])
}

model History {
  id         String   @id @default(cuid())
  userId     String
  title      String
  url        String
  imageUrl   String?  @default("")
  clickCount Int      @default(1) // Novo campo para analytics
  viewedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiStatus {
  id              String   @id @default("singleton")
  newsApiQuota    Int      @default(100)
  gnewsQuota      Int      @default(100)
  lastUpdated     DateTime @default(now())
}

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique // ex: "technology"
  label     String           // ex: "Tecnologia"
  keywords  String[]         // ex: ["apple", "google"]
  createdAt DateTime @default(now())
}

model CachedArticle {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String   @unique
  source      String?
  imageUrl    String?
  category    String
  language    String   @default("pt")
  publishedAt DateTime?
  cachedAt    DateTime @default(now())

  @@index([category, language])
  @@index([publishedAt])
}
