# =========================================================================
#              TRACKFEED - CONFIGURAÇÃO DE AMBIENTE (.env)
# =========================================================================
# Copie este arquivo para um arquivo chamado `.env` na raiz do seu projeto.
# =========================================================================

# -------------------------------------------------------------------------
# 🛠️ SEÇÃO A: CORE / DESENVOLVIMENTO LOCAL (OBRIGATÓRIO)
# Estes campos são essenciais para que o site funcione localmente (npm run dev).
# -------------------------------------------------------------------------

# 1. Conexão com o Banco de Dados (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/trackfeed?schema=public"

# 2. Chave de Inteligência Artificial (Google AI Studio - Gemini)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY="sua-chave-do-gemini-aqui"

# 3. Chaves das APIs de Notícias (Provedores Externos)
# NewsAPI (Provedor Principal): Obtenha em https://newsapi.org/
NEWS_API_KEY="sua-chave-newsapi-aqui"

# GNews (Provedor Reserva / Fallback): Obtenha em https://gnews.io/
GNEWS_API_KEY="sua-chave-gnews-aqui"

# The Guardian (Provedor Reserva / Fallback): Obtenha em https://open-platform.theguardian.com/
GUARDIAN_API_KEY="sua-chave-guardian-aqui"


# -------------------------------------------------------------------------
# 🚀 SEÇÃO B: PRODUÇÃO / DEPLOY ONLINE (OPCIONAL LOCALMENTE)
# Estes campos são exigidos APENAS caso você queira lançar o site online (Vercel).
# Eles são automaticamente ignorados/desativados no ambiente de desenvolvimento local.
# -------------------------------------------------------------------------

# 1. Envio de PIN de Verificação de Conta (Resend)
# Obtenha em: https://resend.com/
RESEND_API_KEY="sua-chave-do-resend-aqui"
# E-mail registrado na conta do Resend para envio em modo Sandbox (opcional para testes locais)
RESEND_SANDBOX_EMAIL="seu-email-do-resend-aqui"

# 2. Segurança Anti-Bot nas telas de Login/Cadastro (Google reCAPTCHA v2)
# Obtenha gratuitamente criando um site reCAPTCHA v2 em: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="sua-chave-publica-recaptcha-aqui"
RECAPTCHA_SECRET_KEY="sua-chave-privada-recaptcha-aqui"
